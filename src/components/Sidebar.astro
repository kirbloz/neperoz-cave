---
import "../styles/global.css";
import { Image } from "astro:assets";

import NekoBorg from "../assets/images/nekoweborg004.gif";
import Snipchu from "../assets/images/snipchu.gif";
import ButtonNep from "../assets/images/nep-button-kirby.png";
import IgnesFatui from "../assets/images/ignes-fatui.gif";
import Arch from "../assets/images/arch.png";
import NoChrome from "../assets/images/nochrome.gif";
import Dilbert from "../assets/images/dilbert.gif";
import Paws from "../assets/images/paws-button.png";
import GNULinux from "../assets/images/gnu-linux.gif";
import ApertureScience from "../assets/images/aperture2.jpg";
import ACAB from "../assets/images/acab.gif";
import NavigatorBox from "../components/NavigatorBox.astro";
---

<aside class="sidebar">
  <!-- src/components/Sidebar.astro -->
  <NavigatorBox />
  <!-- buttonz -->

  <!-- left marquee -->
  <marquee class="button-marquee" scrollamount="5" direction="left">
    <a href="https://nekoweb.org/">
      <Image
        src={NekoBorg}
        alt="Nekoweb button"
        width="88"
        height="31"
        loading="lazy"
        decoding="async"
      />
    </a>
    <a href="https://kat.nekoweb.org/"
      ><img
        src="https://kat.nekoweb.org/buttons/button_space.png"
        alt="katspace"
        title="katspace"
        width="88"
        height="31"
      /></a
    >
    <a href="https://slowie.neocities.org/">
      <img src="https://slowie.neocities.org/common/banners/button1.gif" />
    </a>
    <a href="https://snipchu.neocities.org/site">
      <Image src={Snipchu} alt="snipchu user website" />
    </a>
    <a href="https://melankorin.net/">
      <img src="https://melankorin.net/assets/img/buttons/button-1.gif" />
    </a>
    <a href="https://chimera.pet/" title="Chimera's den!"
      ><img src="https://chimera.pet/chimerapet2.gif" /></a
    >
    <a href="https://testtubesterone.nekoweb.org" title="testtubesterone"
      ><img src="https://testtubesterone.nekoweb.org/testtubesterone.png" /></a
    >
    <a href="https://dirk.horse/"><img src="https://dirk.horse/BUTTON.gif" /></a
    >
    <a href="https://computatrum.nekoweb.org"
      ><img
        src="https://computatrum.nekoweb.org/ast/dukebox.gif"
        alt="Board of Computatrum"
      /></a
    >
    <a href="https://nexx2654.nekoweb.org" target="_blank">
      <img src="https://nexx2654.nekoweb.org/images/isopod.gif" />
    </a>
    <a href="https://max.nekoweb.org/"
      ><img
        src="https://max.nekoweb.org/images/button.png"
        alt="max's apartment"
      /></a
    >
  </marquee>

  <!-- right marquee -->
  <marquee class="button-marquee" scrollamount="5" direction="right">
    <Image src={Arch} alt="ArchLinux user" />
    <Image src={NoChrome} alt="Against Chrome Web Browser" />
    <Image src={Dilbert} alt="Dilbert" />
    <a href="https://yesterhost.neocities.org/archive/buttons"
      ><img
        src="https://yesterhost.neocities.org/archive/buttons/button274.gif"
      /></a
    >
    <a href="https://yesterhost.neocities.org/archive/buttons"
      ><img
        src="https://yesterhost.neocities.org/archive/buttons/button397.gif"
      /></a
    >
    <Image src={GNULinux} alt="This is running on GNU Linux" />
    <Image src={ApertureScience} alt="Aperture Science Logo" />
    <Image src={Paws} alt="This site was made by paws only" />
    <Image src={ACAB} alt="All Cats Are Beautiful" />
  </marquee>

  <!-- BUTTONS -->
  <div id="buttons-group">
    <div class="sub-header header-friends">
      <div><h3 class="h-subheader">FRIENDS' SITES</h3></div>
    </div>
    <br />
    <a href="https://ignes-fatui.nekoweb.org">
      <Image
        src={IgnesFatui}
        alt="friends button. the text IGNES-FATUI right next to the head of a smiling lamb. in the background there is a bunch of orange and yellow sparkles."
        width={88}
        height={31}
        loading="lazy"
      /></a
    >
  </div>

  <!-- mii -->
  <div class="buttons-group">
    <div class="sub-header header-mii">
      <div><h3 class="h-subheader">MII</h3></div>
    </div>
    <br />
    <a href="https://neperoz-cave.nekoweb.org/">
      <Image
        src={ButtonNep}
        width={88}
        height={31}
        loading="lazy"
        alt="neperoz cave button. blue handwritten text on yellow background saying
      'NEPEROZ' and a little kirby mounting a warp star."
      />
    </a>
  </div>

  <!-- Bandcamp Player -->
  <div
    class="player-container"
    set:html={`<iframe id="g-gendetta-player"
style="border: 0; width: 100%; height: 120px;"
src="https://bandcamp.com/EmbeddedPlayer/track=3350414577/size=large/bgcol=333333/linkcol=e99708/tracklist=false/artwork=small/transparent=true/"
></iframe>`}
  >
    <a href="https://cheapdirtyhorseband.bandcamp.com/track/g-for-gendetta">
      G for Gendetta by Cheap Dirty Horse
    </a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 10px;
  }

  .button-marquee {
    display: block;
  }

  .buttons-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .header-friends {
    width: 140px;
  }

  .header-mii {
    width: 40px;
  }

  .player-container {
    width: 100%;
  }
</style>
