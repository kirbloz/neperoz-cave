---
import { Image } from "astro:assets";
import Warpstar from "../assets/images/warpstar.png";
---

<!-- navigator bar -->
<div class="navigator-wrapper">
  <div class="navigator-header">
    <div>
      <a href="/home">
        <Image
          src={Warpstar}
          id="kirby"
          alt="Warp star, click to go home"
          width={40}
          height={40}
        />
      </a>
    </div>
    <div>
      <h1 class="h-subheader" style="padding-right:15px;">HOME</h1>
    </div>
  </div>
  <div class="navigator-bar">
    <div><a href="/about">ABOUT</a></div>

    <div><a href="/blog">BLOG</a></div>

    <div><a href="/weblog">WEBLOG</a></div>

    <div><a href="/404.html">GALLERY</a></div>

    <div><a href="https://neperoz-cave.atabook.org/">GUESTBOOK</a></div>

    <div><a href="/">ENTRY POINT</a></div>
  </div>
</div>

<style>
  .navigator-wrapper {
    flex-direction: row;
    align-items: center !important;
    gap: 20px;
    width: 100%;
    display: flex;
  }
  .navigator-header {
    background-color: var(--darker-bg-color);
    border: 2px solid var(--gruv-light-gray);
    color: var(--almostwhite);
    border-radius: 2px;
    flex-direction: row;
    gap: 10px;
    padding: 5px 0 5px 10px;
    display: flex;
  }

  .navigator-bar {
    border: 2px dashed var(--orange);
    flex-direction: row;
    flex: 1;
    padding: 5px 10px;
    padding-top: 7px;
    display: flex;
    align-items: center;
  }
  .navigator-bar div {
    flex-grow: 1;
  }

  .navigator-bar > a {
    flex: 1;
    display: inline;
  }
</style>
