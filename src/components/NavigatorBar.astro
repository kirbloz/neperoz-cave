---
import { Image } from "astro:assets";
import Warpstar from "../assets/images/warpstar.png";
---

<!-- navigator bar -->
<div class="navigator-wrapper">
  <div class="navigator-header">
    <div>
      <a href="/home">
        <Image
          src={Warpstar}
          id="kirby"
          alt="Warp star, click to go home"
          width={40}
          height={40}
        />
      </a>
    </div>
    <div>
      <h1 class="h-subheader" style="padding-right:15px;">HOME</h1>
    </div>
  </div>
  <div class="navigator-bar">
    <a href="/about">ABOUT</a>
    <a href="/blog">BLOG</a>
    <a href="/weblog">WEBLOG</a>
    <a href="/404.html">GALLERY</a>
    <a href="/">ENTRY POINT</a>
  </div>
</div>

<style>
  .navigator-wrapper {
    flex-direction: row;
    align-items: center;
    gap: 20px;
    width: 100%;
    display: flex;
  }
  .navigator-header {
    background-color: var(--darker-bg-color);
    border: 2px solid var(--gruv-light-gray);
    color: var(--almostwhite);
    border-radius: 2px;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 5px 0 5px 5px;
    display: flex;
  }

  .navigator-bar {
    border: 2px dashed var(--orange);
    flex-direction: row;
    flex: 1;
    padding: 10px;
    display: flex;
  }
  .navigator-bar > a {
    color: var(--fg-color);
    flex: 1;
    padding: 5px 10px;
    font-weight: 700;
    text-decoration: none;
    font-style: normal;
    display: block;
  }
</style>
