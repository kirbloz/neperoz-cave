---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

import Window from "../components/Window.astro";

import "../styles/layout.css";
import "../styles/window.css";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <main>
        <Window theme="base" title={title}>
          {
            heroImage && (
              <Image
                width={720}
                height={360}
                src={heroImage}
                alt={title}
                class="post-hero"
              />
            )
          }
          <p class="description">{description}</p>
          <p class="post-date">
            <FormattedDate date={pubDate} />&nbsp;
            {
              updatedDate && (
                <span class="last-updated-on">
                  (updated on <FormattedDate date={updatedDate} />)
                </span>
              )
            }
          </p>
          <hr />
          <div class="prose">
            <slot />
          </div>
          <hr />
          {
            tags && (
              <p class="post-tags">
                {tags.map((tag) => (
                  <a class="tag" href={`/tag/${tag}`}>
                    #{tag}
                  </a>
                ))}
              </p>
            )
          }
        </Window>
      </main>
    </div>
    <Footer />
  </body><style is:global>
    .wincontent {
      padding: 3%;
    }
    .description {
      color: lightblue;
      display: inline;
    }
    .post-date {
    }
    hr {
      padding: 2px;
    }

    .post-hero {
      width: 100%;
      border-radius: 8px;
      margin-bottom: 0.5rem;
    }
    .post-date {
      color: var(--gruv-light-gray);
      font-size: 0.9em;
      margin: 0 0 1rem 0;
    }
    .last-updated-on {
      font-style: italic;
      margin-left: 0.5em;
    }
    .prose {
      color: var(--almostwhite);
      line-height: 1.6;
    }
    .prose h2,
    .prose h3 {
      color: var(--gruv-yellow);
      margin-top: 1.5em;
    }
    .window.base .wincontent a {
      color: var(--gruv-blue);
      text-decoration: underline;
    }
    .prose code {
      background-color: var(--darker-bg-color);
      color: var(--gruv-aqua);
      padding: 2px 6px;
      border-radius: 4px;
    }
    .prose pre {
      background-color: var(--darker-bg-color);
      padding: 1em;
      border-radius: 8px;
      overflow-x: auto;
    }
    .wincontent blockquote {
      border-left: 4px solid var(--gruv-orange);
      padding-left: 1em;
      color: var(--gruv-light-gray);
    }
  </style>
</html>
