---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <container>
      <Sidebar />
      <div id="main">
        <div class="window base">
          <div class="windowHeader">
            <h1>{title}</h1>
            <span title="Minimize" class="winminimize"><span></span></span>
            <span title="Maximize" class="winmaximize"
              ><span></span><span></span></span
            >
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent">
            {
              heroImage && (
                <Image
                  width={720}
                  height={360}
                  src={heroImage}
                  alt={title}
                  class="post-hero"
                />
              )
            }
            <p class="post-date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <span class="last-updated-on">
                    (aggiornato il <FormattedDate date={updatedDate} />)
                  </span>
                )
              }
            </p>
            <hr />
            <div class="prose">
              <slot />
            </div>
          </div>
        </div>
      </div>
    </container>
    <Footer />
  </body>
</html>

<style>
  .post-hero {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }
  .post-date {
    color: var(--gruv-light-gray);
    font-size: 0.9em;
    margin: 0 0 1rem 0;
  }
  .last-updated-on {
    font-style: italic;
    margin-left: 0.5em;
  }
  .prose {
    color: var(--almostwhite);
    line-height: 1.6;
  }
  .prose h2,
  .prose h3 {
    color: var(--gruv-yellow);
    margin-top: 1.5em;
  }
  .prose a {
    color: var(--gruv-blue);
  }
  .prose code {
    background-color: var(--darker-bg-color);
    color: var(--gruv-aqua);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .prose pre {
    background-color: var(--darker-bg-color);
    padding: 1em;
    border-radius: 8px;
    overflow-x: auto;
  }
  .prose blockquote {
    border-left: 4px solid var(--gruv-orange);
    padding-left: 1em;
    color: var(--gruv-light-gray);
  }
</style>
