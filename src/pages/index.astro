---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";

import Froggy from "../assets/images/froggy1024.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <link href="https://github.com/kirbloz" rel="me" />
    <link href="https://xn--sr8hvo.ws/previous" />
    <link href="https://xn--sr8hvo.ws/next" />
    <meta
      name="text:URL Main Cursor"
      content="url(https://cur.cursors-4u.net/games/gam-12/gam1106.cur)"
    />
  </head>

  <body style="display: block">
    <div
      class="container"
      style="text-align: center; display: flex; justify-content: center"
    >
      <div style="margin: 5% auto">
        <h1 style="color: var(--gruv-yellow); font-size: 30px; margin: 1px">
          LOOK UP TO THE SKIES..
        </h1>
        <br />
        <h1 style="color: var(--gruv-yellow); font-size: 30px; margin: 1px">
          FROGS AND STARS ARE HERE ?
        </h1>
        <br />
        <h1 style="color: var(--gruv-yellow); font-size: 30px; margin: 1px">
          CLICK ME!
        </h1>

        <a href="/home">
          <img
            style="width: 500px; height: 500px; margin: 10px"
            src={Froggy.src}
            alt="click to enter homepage"
          />
        </a>
        <div>
          <p style="text-align:center; ">
            <a href="https://xn--sr8hvo.ws/previous">←</a>
            An <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a> 🕸💍
            <a href="https://xn--sr8hvo.ws/next">→</a>
          </p>
          <audio controls src="/media/audio/Reflection.mp3">
            Your browser can't play audio. Loser.
          </audio>
        </div>
      </div>
    </div>
    <!--<Footer /> -->
  </body>
</html>
