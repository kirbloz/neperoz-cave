---
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";

import Froggy from "../assets/images/froggy1024.png";
import sona from "../assets/images/sona.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

    <link href="https://github.com/kirbloz" rel="me" />
    <link href="https://xn--sr8hvo.ws/previous" />
    <link href="https://xn--sr8hvo.ws/next" />
    <meta
      name="text:URL Main Cursor"
      content="url(https://cur.cursors-4u.net/games/gam-12/gam1106.cur)"
    />
  </head>
  <div class="h-card" hidden>
    <div>
      <p class="p-note">
        you may refer to me as <a
          href="https://neperoz-cave.nekoweb.org/about"
          rel="me"
          class="p-nickname u-url">neperoz</a
        >, and i am currently embarked on a (hellish) journey of figuring out
        university
      </p>
    </div>
    <div>
      <img id="sona" class="u-photo" src={sona.src} />
    </div>
  </div>

  <body style="display: block">
    <div class="landing-wrapper">
      <div class="landing-content">
        <h1>LOOK UP TO THE SKIES..</h1>
        <h1>FROGS AND STARS ARE HERE ?</h1>
        <h1>CLICK ME!</h1>

        <a href="/home" class="frog-link">
          <img
            class="frog-img"
            src={Froggy.src}
            alt="click to enter homepage"
          />
        </a>
        <div class="webring-audio-container">
          <p class="webring-text">
            <a href="https://xn--sr8hvo.ws/previous">←</a>
            An <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a> 🕸💍
            <a href="https://xn--sr8hvo.ws/next">→</a>
          </p>
          <audio controls autoplay src="/media/audio/Reflection.mp3">
            Your browser can't play audio. Loser.
          </audio>
        </div>
      </div>
    </div>
    <!--<Footer /> -->
  </body>
  <style>
    h1 {
      color: var(--gruv-yellow);
      font-size: clamp(20px, 4.5vw, 30px);
      line-height: 1.3;
      margin: 10px 0px;
      text-align: center;
    }

    .landing-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      box-sizing: border-box;
    }

    .landing-content {
      max-width: 550px;
      width: 100%;
      margin: auto;
      text-align: center;
    }

    .landing-content h1 {
      color: var(--gruv-yellow);
      font-size: clamp(1.3rem, 5vw, 1.8rem);
      margin: 5px 0;
      line-height: 1.2;
    }

    .landing-content .click-me {
      margin-top: 15px;
    }

    .frog-link {
      display: inline-block;
      margin: 15px auto;
      max-width: 100%;
    }

    .frog-img {
      width: 100%;
      max-width: 500px;
      height: auto;
      display: block;
      image-rendering: pixelated;
    }

    .webring-audio-container {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    .webring-text {
      text-align: center;
      margin: 0;
    }

    audio {
      max-width: 100%;
    }
  </style>
</html>
