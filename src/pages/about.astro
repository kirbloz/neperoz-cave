---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import "../styles/layout.css";
import Window from "../components/Window.astro";

import { Image } from "astro:assets";
import OwlTK from "../assets/images/owl-tk.jpg";
import Dwarf from "../assets/images/dwarf.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <main>
        <Window theme="base" title="✮ABT ME✮">
          <h1>wip</h1>
          <div style="display:flex;">
            <div style="padding:20px;">
              <p style="height: auto;">
                here will go my interests and other personal stuff everybody
                wanna know so bad (i see you microsoft)
              </p>
              <hr style="margin: 15px 0;" />
              <p style="text-align: center;">
                male, 23, white
                <span id="trans-flag"></span>
                <br />
                cs eng major
                <br />
                6w5
              </p>
            </div>
            <div>
              <Image
                id="owl-tk"
                src={OwlTK}
                alt="owl from tokyo ghoul"
                width={150}
                height={150}
              />
            </div>
          </div>
        </Window>

        <!-- win hardware and software -->
        <Window theme="blue" title="⌨ SPECS ⌨">
          <h1>wip</h1>
          <div
            class="profile-section"
            style="justify-content: space-evenly; padding-top: 5px;"
          >
            <div style="text-align:center;">
              <h3 style="color: var(--gruv-yellow)">HW</h3>
              <p>
                Aspire A715-42G
                <br />
                AMD Ryzen 7 5700U
                <br />
                GTX 1650
                <br />
                16GB
              </p>
            </div>
            <div style="text-align:center;">
              <h3 style="color: var(--gruv-yellow)">SW</h3>
              <p>
                <a
                  href="https://archlinux.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Arch Linux Rolling
                </a>
                <br />
                <a
                  href="https://hypr.land/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Hyprland
                </a>
                ,
                <a
                  href="https://www.vim.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  vim
                </a>
                ,
                <a
                  href="https://sw.kovidgoyal.net/kitty/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  kitty
                </a>
                <br />
                <a
                  href="https://github.com/fairyglade/ly"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  ly display manager
                </a>
                <br />
                <a
                  href="http://www.rodsbooks.com/refind/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  rEFInd boot manager
                </a>
                <br />
              </p>
            </div>
          </div>
        </Window>

        <!-- win media i enjoy -->
        <div class="window pink">
          <div class="windowHeader">
            <h1>✿INTERESTS AND MEDIA I LIKE✿</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent">
            <ul style="padding-left: 15px; margin: 0; list-style-type: '＋ ';">
              <li style="margin-bottom: 15px;">reptiles, insects</li>

              <li style="margin-bottom: 15px;">
                videogames
                <div class="games-section">
                  <div style="flex: 1;">
                    <ul style="list-style-type: '－ '; padding: 0px 15px;">
                      <li>minecraft, dwarf fortress</li>
                      <li>shapez.io, factorio, factory-sims</li>
                      <li>kirby, outer wilds</li>
                      <li>monster hunter world</li>
                    </ul>
                  </div>
                  <div>
                    <a href="https://www.bay12games.com/dwarves/">
                      <Image id="dwarf" src={Dwarf} alt="Dwarf fortress logo" />
                    </a>
                  </div>
                </div>
              </li>

              <li style="margin-bottom: 15px;">
                anime, manga/manhwa/webcomics

                <ul
                  style="list-style-type: '♲ '; padding-left: 15px; margin-top: 5px;"
                >
                  <li>
                    stories i enjoy:
                    <ul style="margin-left:5%;">
                      <p style="font-size: 0.95rem; opacity: 0.9; ">
                        evangelion (normie), puella madoka magica, kill la kill,
                        a certain scientific railgun, little witch academia, the
                        melancholy of haruhi suzumiya, soul eater, tokyo
                        ghoul:re, hardcore leveling warrior, hxh, shimanami
                        tasogare, chainsaw man, dorohedoro, gachiakuta, fire
                        punch, vagabond, omniscient reader's viewpoint,
                        homestuck
                      </p>
                    </ul>
                  </li>
                  <li style="margin-top: 5px;">
                    <li>
                      characters i like:
                      <ul style="margin-left:5%;">
                        <p style="font-size: 0.95rem; opacity: 0.9; ">
                          kaneki ken, shinji ikari, kaiman, zanka nijiku, jolyne
                          kuujou, hlw, angel devil, togata (fire punch)
                        </p>
                      </ul>
                    </li>
                  </li>
                </ul>
              </li>
              <ul>unhealthy ado obsession</ul>

              <!-- win tech -->
            </ul>
            <!-- no more windows???? -->
          </div>
        </div>
      </main>
    </div>
    <Footer />
  </body><style>
    #owl-tk {
      display: block;
      margin: 10px auto;
      border-radius: 5px;
      width: 150px;
      max-width: 100%;
      height: auto;
      object-fit: cover;
    }

    .profile-section {
      display: flex;
      gap: 20px;
    }

    .games-section {
      display: flex;
      gap: 15px;
    }

    #dwarf {
      margin: 10px auto;
      border: 2px solid var(--almostwhite);
      border-radius: 5px;
      max-width: 120px;
      height: auto;
      display: block;
    }
  </style>
</html>
