---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import "../styles/global.css";

import { Image } from "astro:assets";
import OwlTK from "../assets/images/owl-tk.jpg";
import Dwarf from "../assets/images/dwarf.png";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      #owl-tk {
        float: center;
        margin: 0 35px;
        /*border: 2px solid var(--almostwhite);*/
        border-radius: 5px;
        width: 180px;
        max-width: 100%;
        max-height: 100%;
        vertical-align: central;
        position: relative;
        object-fit: cover;
        image-rendering: smooth;
      }
    </style>
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />

      <!-- content boxes -->

      <!-- windows?????? -->
      <div id="main">
        <!-- win one -->
        <div class="window base">
          <div class="windowHeader">
            <h1>✮ABT ME✮</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent">
            <h1>wip</h1>

            <div style="display: flex;">
              <div style="max-width: 350px; justify-content: space-evenly; ">
                <p style="height: auto;">
                  here will go my interests and other personal stuff everybody
                  wanna know so bad (i see you microsoft)
                </p>
                <hr style="margin: 15px;" />
                <p
                  style="text-align: center; height: auto;vertical-align:center;"
                >
                  male, 23, white
                  <span id="trans-flag"></span>
                  <br />
                  cs eng major
                  <br />
                  6w5
                </p>
              </div>
              <div>
                <a>
                  <Image
                    id="owl-tk"
                    src={OwlTK}
                    alt="owl from tokyo ghoul"
                    width={180}
                    height={180}
                  />
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- win hardware and software -->
        <div class="window blue">
          <div class="windowHeader">
            <h1>⌨ SPECS ⌨</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent">
            <div
              style="display: flex; justify-content: space-evenly; padding-top: 5px; "
            >
              <div style="text-align:center;">
                <h3 style="color: var(--gruv-yellow)">HW</h3>
                <p style="">
                  Aspire A715-42G
                  <br />
                  AMD Ryzen 7 5700U
                  <br />
                  GTX 1650
                  <br />
                  16GB
                </p>
              </div>
              <div style="text-align:center;">
                <h3 style="color: var(--gruv-yellow)">SW</h3>
                <p>
                  <a
                    href="https://archlinux.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Arch Linux Rolling
                  </a>
                  <br />
                  <a
                    href="https://hypr.land/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Hyprland
                  </a>
                  ,
                  <a
                    href="https://www.vim.org/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    vim
                  </a>
                  ,
                  <a
                    href="https://sw.kovidgoyal.net/kitty/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    kitty
                  </a>
                  <br />
                  <a
                    href="https://github.com/fairyglade/ly"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    ly display manager
                  </a>
                  <br />
                  <a
                    href="http://www.rodsbooks.com/refind/"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    rEFInd boot manager
                  </a>
                  <br />
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- win media i enjoy -->
        <div class="window pink">
          <div class="windowHeader">
            <h1>✿INTERESTS AND MEDIA I LIKE✿</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent">
            <li>
              <ul>
                <li>＋ reptiles, insects</li>
              </ul>
              <ul>
                <div style="display: flex;">
                  <div>
                    ＋ videogames
                    <br />
                    <li>
                      <ul>minecraft, dwarf fortress</ul>
                      <ul>shapez.io, factorio, factory-sims in general</ul>
                      <ul>kirby, outer wilds</ul>
                      <ul>monster hunter world</ul>
                    </li>
                  </div>
                  <div>
                    <a href="https://www.bay12games.com/dwarves/">
                      <Image
                        id="dwarf"
                        style="float: center; margin: 0 35px; border: 2px solid var(--almostwhite); border-radius: 5px;"
                        src={Dwarf}
                        alt="Dwarf fortress logo"
                      />
                    </a>
                  </div>
                </div>
              </ul>
              <ul>
                ＋ anime, manga/manhwa/webcomics
                <br />
                <li>
                  <ul>♲ stories i enjoy:</ul>
                  <ul style="margin-left: 20px;">
                    evangelion (normie), puella madoka magica, kill la kill, a
                    certain scientific railgun, little witch academia, the
                    melancholy of haruhi suzumiya, soul eater, tokyo ghoul:re,
                    hardcore leveling warrior, hxh, shimanami tasogare, chainsaw
                    man, dorohedoro, gachiakuta, fire punch, vagabond,
                    omniscient reader's viewpoint, homestuck
                  </ul>
                  <ul>♲ characters i like:</ul>
                  <ul style="margin-left: 20px;">
                    kaneki ken, shinji ikari, kaiman, zanka nijiku, jolyne
                    kuujou, hlw, angel devil, togata (fire punch)
                  </ul>
                </li>
              </ul>
              <ul>unhealthy ado obsession</ul>
            </li>
          </div>

          <!-- win tech -->
        </div>
        <!-- no more windows???? -->
      </div>
    </div>
  </body>
</html>
