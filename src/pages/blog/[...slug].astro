---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
  <Content />
</BlogPost>

<style>
  .post-hero {
    width: 100%;
    border-radius: 8px;
    margin-bottom: 0.5rem;
  }
  .post-date {
    color: var(--gruv-light-gray);
    font-size: 0.9em;
    margin: 0 0 1rem 0;
  }
  .last-updated-on {
    font-style: italic;
    margin-left: 0.5em;
  }
  .prose {
    color: var(--almostwhite);
    line-height: 1.6;
  }
  .prose h2,
  .prose h3 {
    color: var(--gruv-yellow);
    margin-top: 1.5em;
  }
  .prose a {
    color: var(--gruv-blue);
  }
  .prose code {
    background-color: var(--darker-bg-color);
    color: var(--gruv-aqua);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .prose pre {
    background-color: var(--darker-bg-color);
    padding: 1em;
    border-radius: 8px;
    overflow-x: auto;
  }
  .prose blockquote {
    border-left: 4px solid var(--gruv-orange);
    padding-left: 1em;
    color: var(--gruv-light-gray);
  }
</style>
