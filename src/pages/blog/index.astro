---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";

import Footer from "../../components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import NavigatorBar from "../../components/NavigatorBar.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const allTags = new Set(posts.flatMap((post) => post.data.tags ?? []));

const tags = [...allTags].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={"THE CAVE | BLOG"} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <div class="container">
      <main style="margin:auto;">
        <NavigatorBar />
        <div class="window base">
          <div class="windowHeader">
            <h1>✉ MAIN.EXE ✉</h1>
            <span title="Minimize" class="winminimize"><span></span></span>
            <span title="Maximize" class="winmaximize"
              ><span></span><span></span></span
            >
            <span title="Close" class="winclose">x</span>
          </div>
          <div class="wincontent">
            <h1>wip</h1>
            <p>
              i like writing short things abt stuff i do or think abt and i
              might publish them here
            </p>
          </div>
        </div>

        <div class="window base" style="border-color: #a29bfe; width: 100%;">
          <div class="windowHeader" style="background-color: #a29bfe;">
            <h1>BLOG_ARCHIVE.EXE</h1>
            <span title="Minimize" class="winminimize"><span></span></span>
            <span title="Maximize" class="winmaximize"
              ><span></span><span></span></span
            >
            <span title="Close" class="winclose">x</span>
          </div>
          <div class="wincontent">
            <h2>my thoughts:</h2>
            <br />

            {
              posts.length === 0 ? (
                <p>
                  <em>ancora nessun post... presto!</em>
                </p>
              ) : (
                <ul class="blog-list">
                  {posts.map((post) => (
                    <li class="blog-item">
                      <a href={`/blog/${post.id}/`} class="blog-link">
                        <span class="blog-title">{post.data.title}</span>
                        <span class="blog-date">
                          [ <FormattedDate date={post.data.pubDate} /> ]
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
        <div class="window base">
          <div class="windowHeader" style="background-color: #ff7675;">
            <h1>TAG_INDEX.EXE</h1>
            <span title="Minimize" class="winminimize"><span></span></span>
            <span title="Maximize" class="winmaximize"
              ><span></span><span></span></span
            >
            <span title="Close" class="winclose">x</span>
          </div>

          <div class="wincontent" style="min-height: 50px;">
            {
              tags.length === 0 ? (
                <p>
                  <em>nessuna tag trovata</em>
                </p>
              ) : (
                <ul class="tag-list">
                  {tags.map((tag) => (
                    <li class="tag-item">
                      <a href={`/tag/${tag}`} class="tag-link">
                        {tag}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      </main>
    </div>
    <Footer />
  </body><style>
    .blog-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .blog-item {
      margin-bottom: 12px;
      padding: 10px;
      border: 1px dashed var(--cream, #ccc);
      background: rgba(255, 255, 255, 0.05);
      border-radius: 4px;
      transition: background 0.2s ease;
    }
    .blog-item:hover {
      background: rgba(255, 185, 1, 0.1); /* Effetto hover col tuo giallo */
      border-style: solid;
    }
    .blog-link {
      text-decoration: none;
      color: inherit;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 15px;
    }
    .blog-title {
      margin: 0;
      font-size: 1.1rem;
      font-weight: bold;
    }
    .blog-date {
      margin: 0;
      font-size: 0.85rem;
      font-family: monospace;
      opacity: 0.8;
      white-space: nowrap;
    }

    .tag-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag-item {
      margin: 0;
    }

    .tag-link {
      background: rgba(255, 255, 255, 0.05);
      border: 1px dashed var(--cream, #ccc);
      padding: 6px 10px;
      border-radius: 4px;
      color: var(--gruv-aqua);
      text-decoration: none;
      font-size: 0.9rem;
      transition:
        background 0.2s ease,
        border-style 0.2s ease;
    }

    .tag-link:hover {
      background: rgba(255, 185, 1, 0.1);
      border-style: solid;
    }

    @media (max-width: 768px) {
      .blog-link {
        flex-direction: column;
        gap: 5px;
      }

      /* Usa :global() per "bucare" il componente NavigatorBar */
      :global(.navigator-wrapper) {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 10px !important;
      }

      :global(.navigator-bar) {
        flex-direction: column !important;
        gap: 5px;
        padding: 15px !important;
      }
    }
  </style>
</html>
