---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      /* - - - - - - - - notepad theme - - - - - - - - - - - */
      /* https://css-tricks.com/how-to-create-a-notebook-design-with-css/ */

      note {
        /*background-color: #f5f5f5;*/
        background-color: var(--cream);
        width: auto;
        margin: 0 auto;
        padding: 0;
      }

      note > h4 {
        color: #cd0000;
        font-size: 42px;
        letter-spacing: -2px;
        text-align: left;
      }
      .list {
        color: #555;
        font-size: 16px;
        padding: 0 !important;
        width: 500px;
        font-family: courier, monospace;
        border: 1px solid #dedede;
      }
      .list li {
        list-style: none;
        border-bottom: 1px dotted #ccc;
        text-indent: 25px;
        height: auto;
        padding: 10px;
        text-transform: capitalize;
      }
      .list li:hover {
        background-color: #f9f1af;
        -webkit-transition: all 0.2s;
        -moz-transition: all 0.2s;
        -ms-transition: all 0.2s;
        -o-transition: all 0.2s;
      }
      .lines {
        border-left: 1px solid #ffaa9f;
        border-right: 1px solid #ffaa9f;
        width: 2px;
        float: left;
        height: 535px;
        margin-left: 40px;
      }
    </style>
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <!-- content boxes -->

      <!-- windows?????? -->
      <main style="display:flex; flex-direction:column; align-items:center;">
        <note style="">
          <div class="lines" style="flex:1;"></div>

          <ul class="list">
            <li><span>dev to do:</span></li>
            <li>☒ add hardware and software specs</li>
            <li>
              <tmp style="text-decoration:line-through">☐ add visitor count</tmp
              > that did not work
            </li>
            <li>☐ figure out webrings</li>
            <li>
              ☒ organize css styling for window-like divs -&gt; done as for sept
              29th!
            </li>
            <li>☐ optimize for mobile</li>
            <li>☐ add more buttons!!!!</li>
            <li>☐ design a more serious button</li>
            <li>☐ add music player/last played song</li>
            <li>☐ add embed sans fight simulator</li>
            <li>☐ implement gallery/archive</li>
          </ul>
        </note>

        <div class="navspacer"><br /></div>

        <div class="window pink" style="max-width: 30%;">
          <div class="windowHeader">
            <h1>🗁 source code 🗁</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>
          <div class="wincontent" style="">
            <p>this website is currently uhh v2.0</p>
            <p>
              you can find everything <a
                href="https://github.com/kirbloz/neperoz-cave">on my github</a
              >
            </p>
            <br />
            <p style="text-align:center;">▌║█║▌│║▌│║▌║▌█║▌│║▌║▌│║║▌█║▌║█</p>
          </div>
        </div>

        <!-- no more windows???? -->
      </main>
    </div>
  </body>
</html>
