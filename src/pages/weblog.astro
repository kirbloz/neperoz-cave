---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import NotAI from "../assets/images/not-AI.png";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <!-- Chiikawa - https://www.cursors-4u.com/cursor/chiikawa -->
    <link
      rel="stylesheet"
      href="https://cdn.cursors-4u.net/cursors/animated/chiikawa-88aad27d-48.css"
    />
    <!-- End www.Cursors-4U.com Code -->
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <main>
        <div class="weblog-column">
          <note>
            <div class="lines"></div>

            <ul class="list">
              <li><span>dev to do:</span></li>
              <li>☒ add hardware and software specs</li>
              <li>
                <tmp style="text-decoration:line-through"
                  >☐ add visitor count</tmp
                > that did not work
              </li>
              <li>☒ figure out webrings</li>
              <li>
                ☒ organize css styling for window-like divs -&gt; done as for
                sept 29th!
              </li>
              <li>☐ optimize for mobile (kinda started)</li>
              <li>☒ add more buttons!!!!</li>
              <li>☐ design a more serious button</li>
              <li>☐ add music player/last played song</li>
              <li>☐ add embed sans fight simulator</li>
              <li>☐ implement gallery/archive/resources</li>
              <li>☐ implement links page</li>
              <li>☐ add a shrine to punk culture</li>
            </ul>
          </note>
        </div>
        <div class="weblog-column">
          <div class="window pink" style="width: 100%; max-width: 450px;">
            <div class="windowHeader">
              <h1>🗁 source code 🗁</h1>
              <span title="Minimize" class="winminimize">
                <span></span>
              </span>
              <span title="Maximize" class="winmaximize">
                <span></span>
                <span></span>
              </span>
              <span title="Close" class="winclose">x</span>
            </div>
            <div class="wincontent" style="">
              <p>this website is currently uhh v2.0</p>
              <p>
                + you can find everything <a
                  href="https://github.com/kirbloz/neperoz-cave">on my github</a
                >
                <p>
                  + made by paw on <a href="https://vscodium.dev/">vscodium</a>
                </p>
              </p>
              <br />
              <p
                style="text-align:center;overflow: hidden; white-space: nowrap; text-overflow: ellipsis;"
              >
                ▌║█║▌│║▌│║▌║▌█║▌│║▌║▌│║║▌█║▌║█
              </p>
              <p style="text-align:center;">
                <a href="https://notbyai.fyi/"
                  ><Image
                    src={NotAI}
                    alt="Created by a Human not by AI badge"
                    loading="lazy"
                    decoding="async"
                  /></a
                >
                <!-- <a href="https://jigsaw.w3.org/css-validator/check/referer">
                <img
                  style="border:0;width:88px;height:31px"
                  src="https://jigsaw.w3.org/css-validator/images/vcss-blue"
                  alt="Valid CSS!"
                />-->
              </p>
            </div>
          </div>

          <div class="window orangee">
            <div class="windowHeader">
              <h1>more webringz worki in progress</h1>
              <span title="Minimize" class="winminimize">
                <span></span>
              </span>
              <span title="Maximize" class="winmaximize">
                <span></span>
                <span></span>
              </span>
              <span title="Close" class="winclose">x</span>
            </div>
            <div id="webrings-win" class="wincontent">
              <div id="gfdkris">
                <script
                  type="text/javascript"
                  src="https://fabstarotcorner.neocities.org/webring/onionring-variables.js"
                ></script>
                <script
                  type="text/javascript"
                  src="https://fabstarotcorner.neocities.org/webring/onionring-widget.js"
                ></script>
                <div id="MHfanring">
                  <script
                    type="text/javascript"
                    src="https://tesseractcube.neocities.org/rehaul/webring/onionring-variables.js"
                  ></script>
                  <script
                    type="text/javascript"
                    src="https://tesseractcube.neocities.org/rehaul/webring/onionring-widget3.js"
                  ></script>
                  <script
                    src="https://transring.neocities.org/ring.js"
                    data-widget="cloud"></script>
                  <map name="w95widget">
                    <area
                      href="https://baccyflap.com/noai"
                      target="_blank"
                      shape="rect"
                      coords="0,0,308,22"
                      alt="no ai webring"
                      title="no ai webring"
                    />
                    <area
                      href="https://baccyflap.com/noai/?prv&s=npz"
                      target="_top"
                      shape="rect"
                      coords="56,36,130,58"
                      alt="previous"
                      title="previous"
                    />
                    <area
                      href="https://baccyflap.com/noai/?rnd"
                      target="_top"
                      shape="rect"
                      coords="137,36,211,58"
                      alt="random"
                      title="random"
                    />
                    <area
                      href="https://baccyflap.com/noai/?nxt&s=npz"
                      target="_top"
                      shape="rect"
                      coords="218,36,292,58"
                      alt="next"
                      title="next"
                    />
                  </map>
                  <br />
                  <img
                    usemap="#w95widget"
                    src="https://baccyflap.com/noai/w95widget.gif"
                    alt="a gray Windows 95 style dialog box titled 'The No AI Webring' with a little icon showing a computer chip in a rubbish bin. beside it are three clickable buttons, labeled Previous, Random... and Next"
                  />
                </div>
              </div>
            </div>
          </div>
          <center>
            <p>
              <a href="https://jigsaw.w3.org/css-validator/check/referer">
                <img
                  style="border:0;width:88px;height:31px"
                  src="https://jigsaw.w3.org/css-validator/images/vcss"
                  alt="Valid CSS!"
                />
              </a>
            </p>
          </center>
        </div>
        <!-- no more windows???? -->
      </main>
    </div>
    <Footer />
  </body><style>
    main {
      display: flex;
      flex-direction: flex-start;
      justify-content: space-evenly;
      align-items: center;
      width: 100%;
      padding-left: auto;
      padding-right: 5%;
      flex-wrap: wrap;
    }
    main > * {
      max-width: 500px;
    }
    #webrings-win {
      max-height: 300;
      overflow: scroll;
      scroll-behavior: smooth;
      scrollbar-color: var(--gruv-orange);
    }

    .weblog-column {
      flex-grow: 1;
    }
  </style>
</html>
