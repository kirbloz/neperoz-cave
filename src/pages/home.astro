---
import BaseHead from "../components/BaseHead.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import sona from "../assets/images/sona.jpg";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/*.{png,jpg,jpeg,gif,svg}",
  { eager: true },
);

function getImage(name: string) {
  const img = images[`../assets/images/${name}`]?.default;
  if (!img) throw new Error(`Image not found: ${name}`);
  return img;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <div class="container">
      <Sidebar />
      <main>
        <div class="window base">
          <div
            class="windowHeader"
            style="background-color: #ffb901; border: 2px solid var(--cream);"
          >
            <h1>WELCOME.EXE</h1>
