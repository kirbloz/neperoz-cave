---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/*.{png,jpg,jpeg,gif,svg}",
  { eager: true },
);

function getImage(name: string) {
  const img = images[`../assets/images/${name}`]?.default;
  if (!img) throw new Error(`Image not found: ${name}`);
  return img;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`404 NOT FOUND | ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body>
    <Header />
    <div class="container">
      <main style="width:100%;">
        <div class="window base" style="border-color: #dc3545; width:100%;">
          <div
            class="windowHeader"
            style="background-color: #dc3545; border: 2px solid var(--cream);"
          >
            <h1>ERROR_404.EXE</h1>
            <span title="Minimize" class="winminimize">
              <span></span>
            </span>
            <span title="Maximize" class="winmaximize">
              <span></span>
              <span></span>
            </span>
            <span title="Close" class="winclose">x</span>
          </div>
          <div class="wincontent">
            <h1 style="font-size: clamp(20px, 5vw, 30px);">page not found!</h1>
            <div class="error-layout">
              <div>
                <p>
                  uh oh! it seems you've stumbled upon a broken link, or maybe
                  nepero haven't coded this page yet (web dev is hard, ok?).
                </p>
                <p>
                  <a href="/home" style="font-weight: bold; color: #ffb901;">
                    [ click here to go back home ]
                  </a>
                </p>
              </div>
              <div>
                <Image
                  src={getImage("kirbyinhaling2.gif")}
                  alt="Kirby inhaled this page"
                />
              </div>
            </div>
            <br />
            <hr />
            <br />
            <div style="text-align: center;">
              <p>meanwhile, you can look at this dancing kirby:</p>
              <Image
                src={getImage("kirbydance.gif")}
                alt="Kirby dancing sprite"
                style="max-width: 80px; height: auto;"
              />
            </div>
          </div>
        </div>
      </main>
    </div>
  </body><style>
    .window,
    .wincontent,
    .container,
    main {
      box-sizing: border-box;
    }

    .window {
      max-width: 100% !important;
    }
    .error-layout {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .kirby-inhale {
      max-width: 120px;
      width: 100%;
      height: auto;
    }

    @media (max-width: 600px) {
      .container {
        padding: 10px !important;
        width: 100% !important;
        overflow-x: hidden;
      }
      .error-layout {
        flex-direction: column-reverse;
        text-align: center;
        gap: 15px;
      }
      .kirby-inhale {
        max-width: 90px;
      }
    }
  </style>
</html>
